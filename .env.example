# Copy this file to .env and fill in real values
# DO NOT commit .env to version control

PBS_REPOSITORY=user@pbs!token@<PBS_SERVER_IP>:<DATASTORE>
PBS_PASSWORD=<API_TOKEN_SECRET>
PBS_FINGERPRINT=<SERVER_TLS_FINGERPRINT>
BACKUP_PATH_WORKER=/root/docker/production
BACKUP_PATH_MANAGER=/home/nshsrvr/docker/production
